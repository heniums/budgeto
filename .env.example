# Local development / test database (embedded PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/budgeto

# Authentication
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
